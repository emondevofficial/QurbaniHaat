# Required in production (configure in Vercel Project Settings > Environment Variables).

# Vercel Production: set APP_URL=https://qurbani-haat-rosy.vercel.app in project settings.
# Local development only: use http://localhost:3000.
APP_URL=http://localhost:3000

# Random secret of at least 32 characters. Keep server-side.
AUTH_SECRET=

# Google OAuth credentials from Google Cloud Console. Keep server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development only: SQLite file. Do not use this path in Vercel.
# Vercel Production: set DATABASE_URL to the persistent Turso/libSQL URL (libsql://...).
DATABASE_URL=./auth.sqlite

# Required in Vercel when DATABASE_URL uses a remote libSQL database.
DATABASE_AUTH_TOKEN=

# Optional settings
PORT=3000
AUTH_TRUSTED_PROXIES=
VITE_APP_TITLE=Qurbani Haat
VITE_MARKETPLACE_CURRENCY=BDT
GEMINI_API_KEY=
