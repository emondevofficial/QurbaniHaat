APP_URL=
AUTH_SECRET=
AUTH_TRUSTED_PROXIES=
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
APP_URL=http://localhost:3000

# Local SQLite file for development. Serverless deployments need a persistent Turso/libSQL URL.
DATABASE_URL=./auth.sqlite

# Optional server port; defaults to 3000.
PORT=3000

# Required with a remote libSQL DATABASE_URL; keep this server-only.
DATABASE_AUTH_TOKEN=

# Optional comma-separated proxy IP/CIDRs for trusted X-Forwarded-For parsing.
AUTH_TRUSTED_PROXIES=

# Optional application settings
VITE_APP_TITLE=Qurbani Haat
VITE_MARKETPLACE_CURRENCY=BDT

# Optional server-side Gemini integration
GEMINI_API_KEY=
