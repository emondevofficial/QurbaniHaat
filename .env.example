# Required in production (configure in Vercel Project Settings > Environment Variables).

# Canonical HTTPS site origin in production. Vercel's production domain is used if unset.
# Use http://localhost:3000 for local development.
APP_URL=http://localhost:3000

# Random secret of at least 32 characters. Keep server-side.
AUTH_SECRET=

# Google OAuth credentials from Google Cloud Console. Keep server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development: SQLite file. Serverless: persistent Turso/libSQL URL.
DATABASE_URL=./auth.sqlite

# Required when DATABASE_URL uses a remote libSQL database.
DATABASE_AUTH_TOKEN=

# Optional settings
PORT=3000
AUTH_TRUSTED_PROXIES=
VITE_APP_TITLE=Qurbani Haat
VITE_MARKETPLACE_CURRENCY=BDT
GEMINI_API_KEY=
