# Server-only authentication settings. Never prefix these with VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
APP_URL=http://localhost:3000

# Local SQLite file. Production must point this at persistent mounted storage.
DATABASE_URL=./auth.sqlite

# Optional comma-separated proxy IP/CIDRs for trusted X-Forwarded-For parsing.
AUTH_TRUSTED_PROXIES=

# Optional application settings
VITE_APP_TITLE=QurbaniHaat
VITE_MARKETPLACE_CURRENCY=BDT

# Optional server-side Gemini integration
GEMINI_API_KEY=
